{
  "name": "@causentra/sdk",
  "version": "1.0.0",
  "description": "Framework-neutral multi-agent observability and tracing SDK for Causentra",
  "keywords": [
    "ai-agents",
    "agent-observability",
    "multi-agent",
    "tracing",
    "opentelemetry",
    "local-first"
  ],
  "homepage": "https://github.com/YuvanoLabs/causentra/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuvanoLabs/causentra.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/YuvanoLabs/causentra/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./schema/v1": {
      "default": "./schema/runtime-event-v1.schema.json"
    },
    "./schema/signature-v1": {
      "default": "./schema/signature-v1.schema.json"
    }
  },
  "files": [
    "dist/src",
    "schema",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "dependencies": {
    "canonicalize": "4.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.2"
  },
  "license": "Apache-2.0"
}
