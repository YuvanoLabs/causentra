{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.causentra.dev/signature/v1.json",
  "title": "Causentra Detached Telemetry Signature v1",
  "description": "Versioned detached signature envelope; it does not alter RuntimeEvent v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signatureVersion",
    "artifact",
    "canonicalization",
    "algorithm",
    "keyId",
    "keyVersion",
    "signatureEncoding",
    "signature"
  ],
  "properties": {
    "signatureVersion": { "const": "causentra.signature/v1" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "canonicalization": { "const": "RFC8785-JCS" },
    "algorithm": { "enum": ["ECDSA_P256_SHA256", "ED25519"] },
    "keyId": { "$ref": "#/$defs/keyIdentity" },
    "keyVersion": { "$ref": "#/$defs/keyVersion" },
    "signatureEncoding": { "enum": ["base64-der", "base64-raw"] },
    "signature": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "minLength": 4,
      "maxLength": 2048
    }
  },
  "allOf": [
    {
      "if": { "properties": { "algorithm": { "const": "ECDSA_P256_SHA256" } } },
      "then": { "properties": { "signatureEncoding": { "const": "base64-der" } } }
    },
    {
      "if": { "properties": { "algorithm": { "const": "ED25519" } } },
      "then": { "properties": { "signatureEncoding": { "const": "base64-raw" } } }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "schemaVersion", "sha256"],
      "properties": {
        "kind": { "enum": ["event-batch", "trace-bundle"] },
        "identity": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
        },
        "schemaVersion": { "const": "1.0" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "keyIdentity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "keyVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    }
  }
}
