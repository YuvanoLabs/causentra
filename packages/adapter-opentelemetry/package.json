{
  "name": "@causentra/opentelemetry",
  "version": "0.0.1",
  "description": "OpenTelemetry and OTLP bridge for portable multi-agent Causentra traces",
  "keywords": ["opentelemetry", "otlp", "ai-agents", "agent-observability", "distributed-tracing", "multi-agent"],
  "homepage": "https://github.com/smartbytecoder/causentra/tree/main/packages/adapter-opentelemetry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartbytecoder/causentra.git",
    "directory": "packages/adapter-opentelemetry"
  },
  "bugs": {
    "url": "https://github.com/smartbytecoder/causentra/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist/src", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@causentra/sdk": "0.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.220.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.9.0",
    "@opentelemetry/sdk-trace-node": "2.9.0",
    "@opentelemetry/semantic-conventions": "1.43.0"
  },
  "engines": { "node": ">=22.0.0" },
  "publishConfig": { "access": "public", "provenance": true },
  "sideEffects": false,
  "license": "Apache-2.0"
}
